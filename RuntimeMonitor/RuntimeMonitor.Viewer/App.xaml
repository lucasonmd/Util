<Application x:Class="RuntimeMonitor.Viewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- 다크 테마 색상 팔레트 -->
        <SolidColorBrush x:Key="BackgroundBrush"  Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="PanelBrush"       Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="BorderBrush"       Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="ForegroundBrush"   Color="#FFDCDCDC"/>
        <SolidColorBrush x:Key="AccentBrush"       Color="#FF007ACC"/>
        <SolidColorBrush x:Key="SuccessBrush"      Color="#FF4EC9B0"/>
        <SolidColorBrush x:Key="WarningBrush"      Color="#FFCE9178"/>
        <SolidColorBrush x:Key="ErrorBrush"        Color="#FFF44747"/>

        <Style TargetType="TextBox">
            <Setter Property="Background"     Value="#FF3C3C3C"/>
            <Setter Property="Foreground"     Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush"    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="4,2"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background"     Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="12,4"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="2,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF264F78"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background"   Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground"   Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding"      Value="4,3"/>
        </Style>
    </Application.Resources>
</Application>
