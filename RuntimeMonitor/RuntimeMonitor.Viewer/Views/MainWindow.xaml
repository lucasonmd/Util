<Window x:Class="RuntimeMonitor.Viewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RuntimeMonitor.Viewer.ViewModels"
        xmlns:conv="clr-namespace:RuntimeMonitor.Viewer.Converters"
        Title="RuntimeMonitor Viewer"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">

    <Window.Resources>
        <!-- 로컬 리소스: Converter 인스턴스 등록 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:TypeColorConverter x:Key="TypeColorConverter"/>
        <conv:BooleanInverter x:Key="BoolInverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 툴바 -->
            <RowDefinition Height="Auto"/>   <!-- 필터 바 -->
            <RowDefinition Height="*"/>      <!-- 메인 컨텐츠 -->
            <RowDefinition Height="Auto"/>   <!-- 상태 바 -->
        </Grid.RowDefinitions>

        <!-- ===== 툴바 ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="포트:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Width="60" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInverter}}"/>
                <Button Content="▶ 시작" Command="{Binding StartCommand}"
                        Margin="8,0,0,0" Width="80"/>
                <Button Content="■ 중지" Command="{Binding StopCommand}"
                        Margin="4,0,0,0" Width="80"
                        Background="#FF5A2D82"/>
                <Separator Width="1" Background="{StaticResource BorderBrush}" Margin="8,0"/>
                <Button Content="지우기" Command="{Binding ClearCommand}"
                        Width="70" Background="#FF5F2D2D"/>
                <CheckBox Content="자동 스크롤" IsChecked="{Binding AutoScroll}"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          Foreground="{StaticResource ForegroundBrush}"/>

                <!-- 통계 표시 -->
                <Separator Width="1" Background="{StaticResource BorderBrush}" Margin="8,0"/>
                <TextBlock VerticalAlignment="Center" Margin="4,0">
                    <Run Text="전체: "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                    <Run Text=" | 연결: "/>
                    <Run Text="{Binding ConnectedClients, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}"/>
                    <Run Text="개"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ===== 필터 바 ===== -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="필터:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="#FF9CDCFE"/>
                <TextBlock Text="타입:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Width="150" Text="{Binding TypeFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="타입 이름으로 필터링 (부분 일치)"/>
                <TextBlock Text="메서드:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Width="150" Text="{Binding MethodFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="메서드 이름으로 필터링 (부분 일치)"/>
                <TextBlock Text="프로세스:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Width="120" Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="프로세스 이름으로 필터링 (부분 일치)"/>
                <Button Content="초기화" Command="{Binding ClearFilterCommand}"
                        Margin="8,0,0,0" Width="60" Background="#FF5A5A5A"/>
            </StackPanel>
        </Border>

        <!-- ===== 메인 컨텐츠 (패킷 목록 + 상세보기) ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="4"/>   <!-- Splitter -->
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 패킷 목록 ListView -->
            <ListView Grid.Column="0"
                      x:Name="PacketListView"
                      ItemsSource="{Binding Packets}"
                      SelectedItem="{Binding SelectedPacket}"
                      Background="{StaticResource BackgroundBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="시각" Width="90"
                                        DisplayMemberBinding="{Binding TimestampDisplay}"/>
                        <GridViewColumn Header="프로세스" Width="130"
                                        DisplayMemberBinding="{Binding ProcessDisplay}"/>
                        <GridViewColumn Header="타입" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ShortTypeName}"
                                               Foreground="{Binding TypeDisplay, Converter={StaticResource TypeColorConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="메서드" Width="200"
                                        DisplayMemberBinding="{Binding MethodDisplay}"/>
                        <GridViewColumn Header="파라미터" Width="100"
                                        DisplayMemberBinding="{Binding ParameterDisplay}"/>
                        <GridViewColumn Header="스레드" Width="70"
                                        DisplayMemberBinding="{Binding ThreadDisplay}"/>
                        <GridViewColumn Header="페이로드 미리보기" Width="300"
                                        DisplayMemberBinding="{Binding PayloadSummary}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 리사이즈 스플리터 -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- 상세 보기 패널 -->
            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 상세 보기 헤더 -->
                    <Border Grid.Row="0" Background="#FF2A2A2A" Padding="8,4">
                        <TextBlock Text="패킷 상세" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>

                    <!-- 상세 내용 (선택된 패킷 없을 때 안내 메시지) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <!-- 선택된 패킷 없음 안내 -->
                            <TextBlock Text="패킷을 선택하세요"
                                       Foreground="#FF666666"
                                       HorizontalAlignment="Center"
                                       Margin="0,20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPacket}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 패킷 상세 정보 -->
                            <StackPanel DataContext="{Binding SelectedPacket}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="기본 정보" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,0,4"/>

                                <!-- 메타데이터 그리드 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="시각:" Foreground="#FF888888"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TimestampDisplay}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="프로세스:" Foreground="#FF888888"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProcessDisplay}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="메서드:" Foreground="#FF888888"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MethodDisplay}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="타입:" Foreground="#FF888888"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{Binding TypeDisplay}"
                                               Foreground="{Binding TypeDisplay, Converter={StaticResource TypeColorConverter}}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="스레드:" Foreground="#FF888888"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ThreadDisplay}"/>
                                </Grid>

                                <Separator Margin="0,8" Background="{StaticResource BorderBrush}"/>

                                <TextBlock Text="JSON 페이로드" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,0,4"/>

                                <!-- JSON 표시 영역 -->
                                <Border Background="#FF1A1A1A" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" Padding="8">
                                    <TextBox Text="{Binding FormattedJson, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="{StaticResource SuccessBrush}"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             TextWrapping="Wrap"
                                             BorderThickness="0"
                                             VerticalScrollBarVisibility="Auto"
                                             MaxHeight="400"/>
                                </Border>

                                <!-- 직렬화 오류 표시 (오류가 있을 때만) -->
                                <Border Background="#FF3A1515" BorderBrush="{StaticResource ErrorBrush}"
                                        BorderThickness="1" Padding="8" Margin="0,4,0,0"
                                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="{StaticResource ErrorBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 상태 바 ===== -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="8,3">
            <Grid>
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#FF666666">
                    <Run Text="RuntimeMonitor v1.0 | .NET 8.0 | Harmony + MessagePack + WPF"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
