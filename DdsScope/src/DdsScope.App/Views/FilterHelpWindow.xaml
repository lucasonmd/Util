<Window x:Class="DdsScope.App.Views.FilterHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display filter syntax"
        Height="764" Width="560"
        MinHeight="300" MinWidth="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>

        <!-- The left column of every reference table: the thing you type. -->
        <Style x:Key="Term" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="#1A5276" />
            <Setter Property="Margin" Value="0,0,12,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--
            Kept to short noun phrases rather than sentences. The point of the sheet is to be
            scanned while typing a filter, and prose in this column is what stops it being.
        -->
        <Style x:Key="Meaning" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

    </Window.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0" Padding="8,6">
            <Button Content="Close" IsCancel="True" Width="80" HorizontalAlignment="Right" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,14,14">
            <StackPanel>

                <TextBlock Style="{StaticResource Note}" Margin="0,0,0,2"
                           Text="Decides which rows the grid shows. Capture is never affected." />

                <!-- ============================== fields ============================== -->
                <TextBlock Text="Fields" Style="{StaticResource SectionHeader}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="topic" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Topic name" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="writer" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Writer name" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="writerid" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Writer id" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="type" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Type name" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="key" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Instance key" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="seq" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Sequence number" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="data.&lt;field&gt;" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Payload field. Nested: data.Position.X" Style="{StaticResource Meaning}" />

                    <!--
                        The presence test earns a row of its own: a bare field with no operator
                        is the one form that reads like a mistake until you know what it does.
                    -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="data.&lt;field&gt; alone" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="True when the sample carries it" Style="{StaticResource Meaning}" />
                </Grid>

                <!-- ============================ operators ============================ -->
                <TextBlock Text="Operators" Style="{StaticResource SectionHeader}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="==  !=  &gt;  &gt;=  &lt;  &lt;=" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Compare" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="&amp;&amp;  ||  !" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="And, or, not. Also: and / or / not" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="(  )" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Group" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="contains startsWith endsWith" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Text tests" Style="{StaticResource Meaning}" />
                </Grid>

                <!-- ============================== values ============================== -->
                <TextBlock Text="Values" Style="{StaticResource SectionHeader}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="&quot;text&quot;  'text'" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="String. One word needs no quotes" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="12  -4.5  0x1F" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Number, hex included" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="true  false" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Boolean" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Tracking  2" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Enum: label or number" Style="{StaticResource Meaning}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Abc = abc" Style="{StaticResource Term}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Case is ignored, in field names too" Style="{StaticResource Meaning}" />
                </Grid>

                <!-- ============================= examples ============================= -->
                <TextBlock Text="Examples" Style="{StaticResource SectionHeader}" />

                <!--
                    A read-only TextBox rather than a TextBlock, so an example can be selected
                    and copied straight into the filter box instead of retyped.

                    xml:space="preserve" because XAML otherwise folds the line breaks into
                    spaces and runs every example together on one line. The content therefore
                    starts immediately after the tag and each line begins at column 0.
                -->
                <TextBox IsReadOnly="True" AcceptsReturn="True" xml:space="preserve"
                         BorderThickness="1" BorderBrush="#E0E0E0"
                         Background="#FAFAFA" Padding="8,6" FontFamily="Consolas"
                         Foreground="#1A5276" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto">topic == "C_Rotational_Mount"
writer contains "Writer01"
data.SourceID == 3
data.Info &gt;= 10 &amp;&amp; (data.SourceID == 1 || data.SourceID == 3)
data.Position.X &gt; 0
data.Status == Tracking
!(topic contains "Mount")
data.Samples</TextBox>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
