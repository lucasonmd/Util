<Window x:Class="WpfOverlayApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="HMI Viewer"
        Width="1920" Height="1080"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
        Loaded="Window_Loaded">

    <Grid>

        <!-- 배경 캔버스 -->
        <Canvas Name="LayoutCanvas" Panel.ZIndex="0" Width="1920" Height="1080"/>

        <!-- 네비게이션 바 -->
        <Border VerticalAlignment="Top" Height="48" Panel.ZIndex="1"
                Background="#EA252628"
                MouseLeftButtonDown="NavBar_MouseLeftButtonDown">
            <Grid Margin="16,0">

                <!-- 타이틀 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <materialDesign:PackIcon Kind="Monitor" Width="20" Height="20"
                                             Foreground="#666666" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="HMI Viewer"
                               Foreground="#CCFFFFFF" FontSize="14" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 우측 컨트롤 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,4,0">

                    <!-- 실행 설정 패널 토글 -->
                    <ToggleButton Name="LaunchPanelBtn" Margin="0,0,6,0"
                                  Click="LaunchPanelToggle_Click">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Height" Value="30"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#88FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="15" Padding="{TemplateBinding Padding}">
                                                <materialDesign:Ripple
                                                    Feedback="{TemplateBinding Foreground}"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </materialDesign:Ripple>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsChecked" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                                    <Setter Property="Foreground" Value="#CCFFFFFF"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayCircleOutline" Width="13" Height="13"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="뷰어 실행" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- 레이아웃 편집 토글 -->
                    <ToggleButton Name="EditToggle" Margin="0,0,10,0"
                                  Checked="EditToggle_Checked" Unchecked="EditToggle_Unchecked">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Height" Value="30"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#88FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="15" Padding="{TemplateBinding Padding}">
                                                <materialDesign:Ripple
                                                    Feedback="{TemplateBinding Foreground}"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </materialDesign:Ripple>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsChecked" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                                    <Setter Property="Foreground" Value="#CCFFFFFF"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pencil" Width="13" Height="13"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="레이아웃 편집" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- 최소화 (인라인 템플릿 + Ripple) -->
                    <Button Foreground="#77FFFFFF" Background="Transparent" BorderThickness="0"
                            Width="36" Height="36" Cursor="Hand" Click="MinimizeButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <materialDesign:Ripple Feedback="{TemplateBinding Foreground}"
                                                           HorizontalContentAlignment="Center"
                                                           VerticalContentAlignment="Center">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </materialDesign:Ripple>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18"/>
                    </Button>

                    <!-- 닫기 (인라인 템플릿 + Ripple, 호버 시 빨간색) -->
                    <Button Foreground="#77FFFFFF" Background="Transparent" BorderThickness="0"
                            Width="36" Height="36" Cursor="Hand" Margin="2,0,0,0" Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <materialDesign:Ripple Feedback="{TemplateBinding Foreground}"
                                                           HorizontalContentAlignment="Center"
                                                           VerticalContentAlignment="Center">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </materialDesign:Ripple>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#22FF0000"/>
                                        <Setter Property="Foreground" Value="#FF5252"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- 편집 패널 -->
        <Border Name="EditPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,52,8,0"
                Panel.ZIndex="2"
                Background="#F22F3032"
                BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Width="210">

                <TextBlock Name="EditPanelTitle" Text="Box"
                           Foreground="{DynamicResource PrimaryHueLightBrush}"
                           FontSize="10" FontWeight="Medium"
                           Margin="2,0,0,14"/>

                <TextBox Name="TbX" Margin="0,0,0,8"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="X"
                         materialDesign:HintAssist.IsFloating="True"
                         Foreground="White" CaretBrush="White"
                         TextChanged="TbX_TextChanged"/>

                <TextBox Name="TbY" Margin="0,0,0,8"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Y"
                         materialDesign:HintAssist.IsFloating="True"
                         Foreground="White" CaretBrush="White"
                         TextChanged="TbY_TextChanged"/>

                <TextBox Name="TbW"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="W"
                         materialDesign:HintAssist.IsFloating="True"
                         Foreground="White" CaretBrush="White"
                         TextChanged="TbW_TextChanged"/>

                <Button Content="적용" Margin="0,14,0,0"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="ApplyEdit_Click"/>
            </StackPanel>
        </Border>

        <!-- 실행 설정 패널 -->
        <Border Name="LaunchPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8,52,0,0"
                Panel.ZIndex="2"
                Background="#F22F3032"
                BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Width="340">

                <Grid Margin="0,0,0,14">
                    <TextBlock Text="뷰어 실행"
                               Foreground="White"
                               FontSize="10" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            Height="30" Padding="14,0" FontSize="11" Cursor="Hand"
                            Background="Transparent" Foreground="#88FFFFFF"
                            BorderBrush="#33FFFFFF" BorderThickness="1"
                            Click="LaunchPanelToggle_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="15" Padding="{TemplateBinding Padding}">
                                    <materialDesign:Ripple Feedback="{TemplateBinding Foreground}"
                                                           HorizontalContentAlignment="Center"
                                                           VerticalContentAlignment="Center">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </materialDesign:Ripple>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                        <Setter Property="Foreground" Value="#CCFFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="13" Height="13"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="닫기" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 실행 파일 경로 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="TbExePath" Grid.Column="0" Margin="0,0,6,0"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="실행 파일 경로"
                             materialDesign:HintAssist.IsFloating="True"
                             Foreground="White" CaretBrush="White"
                             IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="탐색"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#99FFFFFF"
                            BorderBrush="#44FFFFFF"
                            Cursor="Hand"
                            Click="BrowseExe_Click"/>
                </Grid>

                <!-- 인수 -->
                <TextBox Name="TbExeArg" Margin="0,0,0,16"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="인수 (argument)"
                         materialDesign:HintAssist.IsFloating="True"
                         Foreground="White" CaretBrush="White"/>

                <!-- 상태 + 실행/중지 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse Name="StatusDot" Width="8" Height="8"
                                 Fill="#484848" Margin="2,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Name="TbLaunchStatus" Text="대기 중"
                                   Foreground="#707070" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Name="BtnLaunch" Grid.Column="1" Content="실행"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Cursor="Hand" Margin="0,0,6,0"
                            Click="LaunchExe_Click"/>

                    <Button Name="BtnStop" Grid.Column="2" Content="중지"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#FF5252" BorderBrush="#44FF5252"
                            IsEnabled="False"
                            Cursor="Hand"
                            Click="StopExe_Click"/>
                </Grid>

            </StackPanel>
        </Border>

    </Grid>
</Window>
