<Window x:Class="WpfOverlayApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay"
        Width="1920" Height="1080"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <!-- 투명 중앙 영역 (영상 시청용) -->
        <Border Background="Transparent"
                Margin="120,80,120,80"
                Name="VideoArea"
                MouseLeftButtonDown="VideoArea_MouseLeftButtonDown" />

        <!-- 상단 컨트롤 바 -->
        <Border VerticalAlignment="Top"
                Height="70"
                Background="#CC1E1E2E"
                CornerRadius="0,0,12,12">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 제목 -->
                <TextBlock Grid.Column="0"
                           Text="Overlay Player"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

                <!-- 투명도 슬라이더 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="불투명도" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                    <Slider Name="OpacitySlider"
                            Width="120"
                            Minimum="0.1"
                            Maximum="1.0"
                            Value="1.0"
                            VerticalAlignment="Center"
                            ValueChanged="OpacitySlider_ValueChanged" />
                </StackPanel>

                <!-- 클릭 통과 토글 -->
                <ToggleButton Grid.Column="2"
                              Name="ClickThroughToggle"
                              Content="클릭 통과"
                              Width="90" Height="36"
                              Margin="0,0,12,0"
                              Background="#3A3A5C"
                              Foreground="White"
                              BorderBrush="#5555AA"
                              FontSize="13"
                              Checked="ClickThroughToggle_Checked"
                              Unchecked="ClickThroughToggle_Unchecked"
                              Style="{StaticResource {x:Type ToggleButton}}" />

                <!-- 닫기 버튼 -->
                <Button Grid.Column="3"
                        Content="✕"
                        Width="40" Height="40"
                        Background="Transparent"
                        Foreground="#FF6B6B"
                        BorderBrush="Transparent"
                        FontSize="18"
                        Click="CloseButton_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#55FF4444"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- 하단 컨트롤 바 -->
        <Border VerticalAlignment="Bottom"
                Height="70"
                Background="#CC1E1E2E"
                CornerRadius="12,12,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button Content="⏮" Width="50" Height="44" Margin="6,0"
                        Click="PrevButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />

                <Button Name="PlayPauseButton"
                        Content="▶" Width="60" Height="44" Margin="6,0"
                        Click="PlayPauseButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />

                <Button Content="⏭" Width="50" Height="44" Margin="6,0"
                        Click="NextButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />

                <Separator Width="1" Height="30" Background="#555577" Margin="16,0" />

                <Button Content="🔇" Name="MuteButton" Width="50" Height="44" Margin="6,0"
                        Click="MuteButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />

                <Slider Name="VolumeSlider"
                        Width="100"
                        Minimum="0"
                        Maximum="100"
                        Value="80"
                        VerticalAlignment="Center"
                        Margin="8,0" />

                <Separator Width="1" Height="30" Background="#555577" Margin="16,0" />

                <Button Content="전체화면" Width="80" Height="44" Margin="6,0"
                        Click="FullscreenButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />

                <Button Content="최소화" Width="70" Height="44" Margin="6,0"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />
            </StackPanel>
        </Border>

        <!-- 좌측 패널 -->
        <Border HorizontalAlignment="Left"
                Width="110"
                Margin="0,70,0,70"
                Background="#881E1E2E">
            <StackPanel VerticalAlignment="Center" Margin="10,0">
                <Button Content="설정" Height="44" Margin="0,6"
                        Click="SettingsButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />
                <Button Content="스크린샷" Height="44" Margin="0,6"
                        Click="ScreenshotButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />
                <Button Content="북마크" Height="44" Margin="0,6"
                        Click="BookmarkButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>

    <Window.Resources>
        <Style x:Key="OverlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3A3A5C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5555AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5555AA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#7777CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
