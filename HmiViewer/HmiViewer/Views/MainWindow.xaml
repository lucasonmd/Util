<Window x:Class="HmiViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HmiViewer.ViewModels"
        xmlns:ctrl="clr-namespace:HmiViewer.Controls"
        xmlns:models="clr-namespace:HmiViewer.Models"
        Title="TACTICAL HMI VIEWER"
        Width="1536" Height="864"
        MinWidth="1200" MinHeight="680"
        Background="{StaticResource BgBlackBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Consolas"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!--
        전체 레이아웃:
        ┌─────────────────────────────────────────────────────┐
        │  HEADER (상단 FUNC 버튼 + 통신 패널)                │
        ├──────┬──────────────────────────┬──────┬────────────┤
        │  F1  │                          │  F7  │  CH 01     │
        │  F2  │    MAIN VIDEO (대형)     │  F8  │  CH 02     │
        │  F3  │                          │  F9  │  CH 03     │
        │  F4  │                          │  F10 │  CH 04     │
        │  F5  │                          │  F11 │  CH 05     │
        │  F6  │                          │  F12 │            │
        ├──────┴──────────────────────────┴──────┴────────────┤
        │  FOOTER (하단 F13~F20 버튼)                         │
        └─────────────────────────────────────────────────────┘
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>   <!-- 상단 FUNC + 통신 -->
            <RowDefinition Height="*"/>    <!-- 메인 콘텐츠 -->
            <RowDefinition Height="50"/>   <!-- 하단 F13~F20 -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════
             ROW 0: 헤더 (FUNC1~8 + 통신 패널)
             ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="6,0">

                <!-- FUNC 버튼 (좌측 균등 배분) -->
                <ItemsControl DockPanel.Dock="Left"
                              ItemsSource="{Binding FuncButtons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Style="{StaticResource FuncButtonStyle}"
                                    Width="88"
                                    Margin="2,8"
                                    Command="{Binding DataContext.SendKeyCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 통신 패널 (우측 고정) -->
                <Border DockPanel.Dock="Right"
                        BorderBrush="{StaticResource BorderNormalBrush}"
                        BorderThickness="1,0,0,0"
                        Padding="12,0"
                        Width="320">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- IP 입력 -->
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource IpTextBoxStyle}"
                                 Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>

                        <!-- RUN 버튼 -->
                        <Button Grid.Column="1"
                                Content="RUN"
                                Style="{StaticResource RunButtonStyle}"
                                Command="{Binding RunCommand}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>

                        <!-- 상태 표시 -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource StatusLabelStyle}"
                                   MinWidth="110">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusLabelStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionState}"
                                                     Value="{x:Static models:ConnectionState.Disconnected}">
                                            <Setter Property="Foreground" Value="{StaticResource StateDisconnectedBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}"
                                                     Value="{x:Static models:ConnectionState.Ready}">
                                            <Setter Property="Foreground" Value="{StaticResource StateReadyBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}"
                                                     Value="{x:Static models:ConnectionState.Running}">
                                            <Setter Property="Foreground" Value="{StaticResource StateRunningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 중앙 타이틀 -->
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="■ TACTICAL HMI VIEWER ■"
                           Foreground="{StaticResource NeonBlueBrush}"
                           FontSize="13"
                           FontWeight="Bold"/>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             ROW 1: 메인 콘텐츠 (좌 버튼 | 메인 영상 | 우 버튼 | 채널 목록)
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>   <!-- 좌측 F1~F6 -->
                <ColumnDefinition Width="*"/>    <!-- 메인 영상 -->
                <ColumnDefinition Width="70"/>   <!-- 우측 F7~F12 -->
                <ColumnDefinition Width="200"/>  <!-- 채널 썸네일 -->
            </Grid.ColumnDefinitions>

            <!-- 좌측 버튼: F1~F6 -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}"
                    BorderThickness="0,0,1,0">
                <ItemsControl ItemsSource="{Binding LeftButtons}" Margin="3,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Style="{StaticResource SideButtonStyle}"
                                    Margin="2,3"
                                    Command="{Binding DataContext.SendKeyCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 메인 영상 영역 -->
            <Border Grid.Column="1"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderNormalBrush}"
                    BorderThickness="1"
                    Margin="1">
                <Grid>
                    <!--
                        VIDEO HOST: 실제 영상 없음 (Transparent).
                        향후 D3DImage / HwndHost / MediaElement 삽입 지점.
                    -->
                    <Border Background="Transparent"
                            x:Name="MainVideoHost"/>

                    <!-- 격자 오버레이 (전술 스타일) -->
                    <Canvas IsHitTestVisible="False" Opacity="0.04">
                        <Line X1="0" Y1="0" X2="3000" Y2="0"
                              Stroke="{StaticResource NeonBlueBrush}" StrokeThickness="0.5"
                              Canvas.Top="180"/>
                        <Line X1="0" Y1="0" X2="3000" Y2="0"
                              Stroke="{StaticResource NeonBlueBrush}" StrokeThickness="0.5"
                              Canvas.Top="360"/>
                        <Line X1="0" Y1="0" X2="3000" Y2="0"
                              Stroke="{StaticResource NeonBlueBrush}" StrokeThickness="0.5"
                              Canvas.Top="540"/>
                        <Line X1="0" Y1="0" X2="0" Y2="3000"
                              Stroke="{StaticResource NeonBlueBrush}" StrokeThickness="0.5"
                              Canvas.Left="260"/>
                        <Line X1="0" Y1="0" X2="0" Y2="3000"
                              Stroke="{StaticResource NeonBlueBrush}" StrokeThickness="0.5"
                              Canvas.Left="520"/>
                        <Line X1="0" Y1="0" X2="0" Y2="3000"
                              Stroke="{StaticResource NeonBlueBrush}" StrokeThickness="0.5"
                              Canvas.Left="780"/>
                    </Canvas>

                    <!-- 선택 채널 레이블 (좌상단) -->
                    <TextBlock Text="{Binding SelectedChannelName}"
                               Style="{StaticResource MainVideoLabelStyle}"/>

                    <!-- 우하단 코너 장식 -->
                    <Path Stroke="{StaticResource NeonBlueBrush}"
                          StrokeThickness="1" Opacity="0.4"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,8,8"
                          Data="M 0,20 L 0,0 L 20,0"/>
                    <Path Stroke="{StaticResource NeonBlueBrush}"
                          StrokeThickness="1" Opacity="0.4"
                          HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          Margin="8,0,0,8"
                          Data="M 0,0 L 20,0 L 20,20"/>
                    <Path Stroke="{StaticResource NeonBlueBrush}"
                          StrokeThickness="1" Opacity="0.4"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,8,8,0"
                          Data="M 20,0 L 0,0 L 0,20"/>
                </Grid>
            </Border>

            <!-- 우측 버튼: F7~F12 -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}"
                    BorderThickness="1,0,0,0">
                <ItemsControl ItemsSource="{Binding RightButtons}" Margin="3,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Style="{StaticResource SideButtonStyle}"
                                    Margin="2,3"
                                    Command="{Binding DataContext.SendKeyCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 우측 채널 썸네일 목록 -->
            <Border Grid.Column="3" Style="{StaticResource PanelBorderStyle}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 패널 타이틀 -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderNormalBrush}"
                            BorderThickness="0,0,0,1" Padding="0,4">
                        <TextBlock Text="[ CHANNELS ]"
                                   Style="{StaticResource SectionLabelStyle}"/>
                    </Border>

                    <!-- 채널 버튼 목록 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Channels}"
                                  Margin="6,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChannelButtonStyle}"
                                        Margin="0,3"
                                        Command="{Binding DataContext.SelectChannelCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <!-- 선택 테두리 강조 -->
                                    <Button.BorderBrush>
                                        <Binding Path="IsSelected">
                                            <Binding.Converter>
                                                <x:Null/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Button.BorderBrush>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ChBorder"
                                                    BorderThickness="1"
                                                    Background="Transparent"
                                                    SnapsToDevicePixels="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderNormalBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BorderSelectedBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <!-- 영상 영역 (Transparent) -->
                                                    <Border Background="Transparent"/>

                                                    <!-- 선택 시 오버레이 강조 -->
                                                    <Border Opacity="0.08">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource NeonCyanBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <!-- 채널 레이블 -->
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="▶ NO SIGNAL"
                                                                   FontFamily="Consolas"
                                                                   FontSize="8"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource TextDimBrush}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- 선택 시 좌측 인디케이터 바 -->
                                                    <Rectangle Width="3"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Stretch">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Fill" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource NeonCyanBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             ROW 2: 하단 F13~F20
             ══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}"
                BorderThickness="0,1,0,0">
            <ItemsControl ItemsSource="{Binding BottomButtons}" Margin="6,5">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}"
                                Style="{StaticResource BottomButtonStyle}"
                                Margin="3,0"
                                Command="{Binding DataContext.SendKeyCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
