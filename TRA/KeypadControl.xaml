<UserControl x:Class="TRA.KeypadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="KbdDigitStyle" TargetType="Button">
            <Setter Property="Background"       Value="#000000"/>
            <Setter Property="Foreground"       Value="#FFFFFF"/>
            <Setter Property="BorderBrush"      Value="#141E2A"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontFamily"       Value="Microsoft Sans Serif"/>
            <Setter Property="FontSize"         Value="22"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A1828"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#162E48"/>
                                <Setter TargetName="bd" Property="BorderBrush"  Value="#3A7090"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBtnStyle" TargetType="Button">
            <Setter Property="Background"       Value="#000000"/>
            <Setter Property="BorderBrush"      Value="#141E2A"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#071422"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0C1E34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <StackPanel>

        <!-- 2×2 필드 선택 -->
        <Grid Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnSelAzMin" Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource FieldBtnStyle}"
                    Click="FieldBtn_Click" Tag="AzMin">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LblAzMin" Text="AZ  MIN"
                               FontFamily="Microsoft Sans Serif" FontSize="20"
                               Foreground="#3C5A70"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock x:Name="ValAzMin"
                               FontFamily="Microsoft Sans Serif" FontSize="22"
                               FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnSelAzMax" Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource FieldBtnStyle}"
                    Click="FieldBtn_Click" Tag="AzMax">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LblAzMax" Text="AZ  MAX"
                               FontFamily="Microsoft Sans Serif" FontSize="20"
                               Foreground="#3C5A70"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock x:Name="ValAzMax"
                               FontFamily="Microsoft Sans Serif" FontSize="22"
                               FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnSelElMin" Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource FieldBtnStyle}"
                    Click="FieldBtn_Click" Tag="ElMin">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LblElMin" Text="EL  MIN"
                               FontFamily="Microsoft Sans Serif" FontSize="20"
                               Foreground="#3C5A70"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock x:Name="ValElMin"
                               FontFamily="Microsoft Sans Serif" FontSize="22"
                               FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnSelElMax" Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource FieldBtnStyle}"
                    Click="FieldBtn_Click" Tag="ElMax">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LblElMax" Text="EL  MAX"
                               FontFamily="Microsoft Sans Serif" FontSize="20"
                               Foreground="#3C5A70"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock x:Name="ValElMax"
                               FontFamily="Microsoft Sans Serif" FontSize="22"
                               FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 입력 표시 -->
        <Border Background="#000000" BorderBrush="#141E2A" BorderThickness="1"
                Margin="0,0,0,8">
            <TextBlock x:Name="KeypadDisplay"
                       Text="---"
                       Foreground="#FFFFFF"
                       FontFamily="Microsoft Sans Serif"
                       FontSize="24"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Padding="0,8"/>
        </Border>

        <!-- 숫자패드 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Content="7" Grid.Row="0" Grid.Column="0" Style="{StaticResource KbdDigitStyle}" Click="Kbd_Click"/>
            <Button Content="8" Grid.Row="0" Grid.Column="2" Style="{StaticResource KbdDigitStyle}" Click="Kbd_Click"/>
            <Button Content="9" Grid.Row="0" Grid.Column="4" Style="{StaticResource KbdDigitStyle}" Click="Kbd_Click"/>

            <Button Content="4" Grid.Row="2" Grid.Column="0" Style="{StaticResource KbdDigitStyle}" Click="Kbd_Click"/>
            <Button Content="5" Grid.Row="2" Grid.Column="2" Style="{StaticResource KbdDigitStyle}" Click="Kbd_Click"/>
            <Button Content="6" Grid.Row="2" Grid.Column="4" Style="{StaticResource KbdDigitStyle}" Click="Kbd_Click"/>

            <Button Content="1" Grid.Row="4" Grid.Column="0" Style="{StaticResource KbdDigitStyle}" Click="Kbd_Click"/>
            <Button Content="2" Grid.Row="4" Grid.Column="2" Style="{StaticResource KbdDigitStyle}" Click="Kbd_Click"/>
            <Button Content="3" Grid.Row="4" Grid.Column="4" Style="{StaticResource KbdDigitStyle}" Click="Kbd_Click"/>

            <Button Content="−" Grid.Row="6" Grid.Column="0" Style="{StaticResource KbdDigitStyle}" Click="Kbd_Click"/>
            <Button Content="0" Grid.Row="6" Grid.Column="2" Style="{StaticResource KbdDigitStyle}" Click="Kbd_Click"/>
            <Button Content="⌫" Grid.Row="6" Grid.Column="4" Style="{StaticResource KbdDigitStyle}" Click="Kbd_Click"/>

            <Button x:Name="BtnEnter"
                    Content="ENTER"
                    Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="5"
                    Style="{StaticResource KbdDigitStyle}"
                    FontSize="22"
                    Click="KbdEnter_Click"/>
        </Grid>

    </StackPanel>
</UserControl>
