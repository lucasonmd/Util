<UserControl x:Class="Progress.Util.CoreLoading.Views.CoreLoadingView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cl="clr-namespace:Progress.Util.CoreLoading"
             Background="Transparent">

    <UserControl.Resources>

        <FontFamily x:Key="PD">pack://application:,,,/Util;component/CoreLoading/Resource/#Pretendard Variable</FontFamily>

        <cl:StateToColorConverter  x:Key="StateToColor" />
        <cl:StageDisplayConverter  x:Key="StageDisplay" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ── 얇은 진행 바 ─────────────────────────────────────── -->
        <Style x:Key="ThinBar" TargetType="ProgressBar">
            <Setter Property="Height"          Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#18FFFFFF"/>
            <Setter Property="Foreground"      Value="#FFBF00"/>
            <Setter Property="Maximum"         Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Restart 버튼 ─────────────────────────────────────── -->
        <Style x:Key="RestartBtn" TargetType="Button">
            <Setter Property="Background"      Value="#44E74C3C"/>
            <Setter Property="Foreground"      Value="#FFCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#55E74C3C"/>
            <Setter Property="FontFamily"      Value="{StaticResource PD}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"   Value="#77E74C3C"/>
                                <Setter Property="BorderBrush"  Value="#99E74C3C"/>
                                <Setter Property="Foreground"   Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close(✕) 버튼 ────────────────────────────────────── -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background"      Value="#18FFFFFF"/>
            <Setter Property="Foreground"      Value="#CCFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="{StaticResource PD}"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 스테이지 셀: Running=앰버 펄스 ──────────────────── -->
        <Style x:Key="StageCell" TargetType="Border">
            <Setter Property="CornerRadius"      Value="4"/>
            <Setter Property="Margin"            Value="4,0"/>
            <Setter Property="MaxHeight"         Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity"           Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static cl:StageState.Running}">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="PulseSB">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.55"
                                                 Duration="0:0:1.1"
                                                 FillBehavior="Stop">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PulseSB"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── 셀 텍스트 ────────────────────────────────────────── -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="TextAlignment"       Value="Center"/>
            <Setter Property="FontFamily"          Value="{StaticResource PD}"/>
            <Setter Property="FontSize"            Value="10"/>
            <Setter Property="FontWeight"          Value="Regular"/>
            <Setter Property="Foreground"          Value="#CCFFFFFF"/>
        </Style>

        <!-- ── Details 버튼 ─────────────────────────────────────── -->
        <Style x:Key="DetailsBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#55FFFFFF"/>
            <Setter Property="BorderBrush"     Value="#28FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="{StaticResource PD}"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="24,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="#12FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                                <Setter Property="Foreground"  Value="#99FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 열 헤더 ───────────────────────────────────────────── -->
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#40FFFFFF"/>
            <Setter Property="FontFamily"        Value="{StaticResource PD}"/>
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="FontWeight"        Value="Medium"/>
            <Setter Property="TextAlignment"     Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <!-- Start() 호출 전엔 완전히 숨김 -->
        <Grid x:Name="ContentRoot" Visibility="Collapsed">

        <!-- ════════════════════════════════════════════════════════
             COMPACT VIEW
        ════════════════════════════════════════════════════════ -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverlayVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                <TextBlock Text="{Binding ProgressText}"
                           FontFamily="{StaticResource PD}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Border Width="1" Background="#28FFFFFF"
                        Margin="14,3" VerticalAlignment="Stretch"/>

                <TextBlock FontFamily="{StaticResource PD}"
                           FontSize="18" Foreground="#77FFFFFF"
                           VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Initializing  ·  {0} Apps">
                            <Binding Path="Apps.Count"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                         Style="{StaticResource ThinBar}"
                         Width="300"/>

            <Button Content="Details"
                    Style="{StaticResource DetailsBtn}"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0"
                    Click="OpenOverlay_Click"/>
        </StackPanel>

        <!-- ════════════════════════════════════════════════════════
             OVERLAY  —  status matrix panel
        ════════════════════════════════════════════════════════ -->
        <!-- 오버레이 Grid: 패널 밖 클릭하면 닫힘 -->
        <Grid Background="Transparent"
              TouchDown="DimBackground_TouchDown"
              MouseDown="DimBackground_MouseDown">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverlayVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Panel: 클릭이 오버레이 Grid로 버블링되지 않도록 차단 -->
            <Border HorizontalAlignment="Center"
                    MouseDown="Panel_MouseDown"
                    TouchDown="Panel_TouchDown"
                    VerticalAlignment="Center"
                    MinWidth="620" MaxWidth="820"
                    Background="#33FAFAFA"
                    BorderBrush="#28FAFAFA"
                    BorderThickness="1"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="48"
                                      ShadowDepth="0" Opacity="0.55"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── Header ─────────────────────────────────── -->
                    <Border Grid.Row="0"
                            Background="#12FAFAFA"
                            CornerRadius="14,14,0,0"
                            Padding="22,12,14,12">
                        <Grid>
                            <!-- Left: title + subtitle -->
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="INITIALIZATION"
                                               FontFamily="{StaticResource PD}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <Border Background="#18FAFAFA" CornerRadius="6"
                                            Padding="8,2" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProgressText}"
                                                   FontFamily="{StaticResource PD}"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="#CCFFFFFF"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Boot sequence in progress"
                                           FontFamily="{StaticResource PD}"
                                           FontSize="10" Foreground="#40FFFFFF"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Right: close button -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Content="✕"
                                    Style="{StaticResource CloseBtn}"
                                    Click="CloseOverlay_Click"/>
                        </Grid>
                    </Border>

                    <!-- ── Content ────────────────────────────────── -->
                    <StackPanel Grid.Row="1" Margin="20,12,20,16">

                            <!-- Column headers -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="78"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="APPLICATION"
                                           Style="{StaticResource ColHeader}"
                                           TextAlignment="Left"/>
                                <UniformGrid Grid.Column="3" Rows="1" Columns="3">
                                    <TextBlock Text="LAUNCH"   Style="{StaticResource ColHeader}"/>
                                    <TextBlock Text="REGISTRY" Style="{StaticResource ColHeader}"/>
                                    <TextBlock Text="TOPLABEL" Style="{StaticResource ColHeader}"/>
                                </UniformGrid>
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,6,0,2"/>

                            <!-- App rows -->
                            <ItemsControl ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type cl:AppInitViewModel}">
                                        <Grid Height="36" Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="78"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Status dot -->
                                            <Ellipse Grid.Column="0"
                                                     Width="6" Height="6"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding OverallState,
                                                            Converter={StaticResource StateToColor}}"/>

                                            <!-- App name -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AppName}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource PD}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Stage cells (outer ItemsControl + UniformGrid) -->
                                            <ItemsControl Grid.Column="3" ItemsSource="{Binding Stages}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="3"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type cl:StageViewModel}">
                                                        <Border Style="{StaticResource StageCell}"
                                                                Background="{Binding State,
                                                                             Converter={StaticResource StateToColor}}">
                                                            <TextBlock Style="{StaticResource CellText}">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource StageDisplay}">
                                                                        <Binding Path="State"/>
                                                                        <Binding Path="StageName"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Restart button -->
                                            <Button Grid.Column="4"
                                                    Content="↺  Restart"
                                                    Command="{Binding RestartCommand}"
                                                    Style="{StaticResource RestartBtn}"
                                                    Margin="8,7,0,7"
                                                    Visibility="{Binding ShowRestartButton,
                                                                 Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,2,0,2"/>

                            <!-- Core Ready row -->
                            <Grid Height="36" Margin="0,2,0,0"
                                  DataContext="{Binding CoreReadyStage}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="78"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0"
                                         Width="6" Height="6"
                                         VerticalAlignment="Center"
                                         Fill="{Binding State, Converter={StaticResource StateToColor}}"/>

                                <TextBlock Grid.Column="2"
                                           Text="StartApp"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource PD}"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="#AAFFFFFF"/>

                                <Border Grid.Column="3"
                                        Style="{StaticResource StageCell}"
                                        Background="{Binding State, Converter={StaticResource StateToColor}}">
                                    <TextBlock Style="{StaticResource CellText}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource StageDisplay}">
                                                <Binding Path="State"/>
                                                <Binding Path="StageName"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                            </Grid>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        </Grid> <!-- ContentRoot -->
    </Grid>
</UserControl>
